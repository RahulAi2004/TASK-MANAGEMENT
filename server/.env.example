DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4100
# Admin login created by `npm run seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123"
# Get a free key at https://console.groq.com/keys — enables Urdu/English voice transcription
GROQ_API_KEY=""

# Roles that may sign in with a password (others use Suite SSO). Default: ADMIN only.
# Before adding SALES/DESIGNER/IT, make sure each of those users has their own password.
PASSWORD_LOGIN_ROLES="ADMIN"
# Time zone used to send one late-task reminder per person per day
REMINDER_TIMEZONE="Asia/Karachi"

// Decoinks Task Management — Prisma schema.
// Dev: SQLite (zero setup). Production: switch provider to "postgresql"
// and set DATABASE_URL to your Postgres connection string — models are portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id        String         @id @default(uuid())
  code      String         @unique // DESIGN, SALES, IT, QA, PROCUREMENT
  name      String
  users     User[]
  tasks     Task[]
  templates TaskTemplate[]
  routines  RoutineTask[]
}

// Blueprint that produces tasks — used by the manual "Use template" action AND by the
// automation engine (Phase 2) which creates a task from a template on a business event.
model TaskTemplate {
  id                 String      @id @default(uuid())
  name               String
  code               String      @unique // e.g. BACKGROUND_REMOVAL — referenced by automation
  description        String?
  taskType           String
  actionType         String      @default("H") // A = Automatic/AI · H = Human task · G = Validation Gate (manager approval)
  entityType         String? // default related module: Artwork | Sales Order | Lead | System
  priority           String      @default("Medium") // Urgent | High | Medium | Low
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  slaHours           Int? // due = createdAt + slaHours (null = no due date)
  estimatedMinutes   Int?
  requiresReview     Boolean     @default(true)
  requiresAcceptance Boolean     @default(false)
  aiFirstAttempt     Boolean     @default(false)
  checklistJson      String? // JSON array of { item, isRequired }
  triggerEvent       String? // business event that auto-creates this task (Phase 2), e.g. SALES_ORDER_CONFIRMED
  dependsOnTaskType  String? // if set, a task from this template waits on the same-entity task of this type
  isActive           Boolean     @default(true)
  usageCount         Int         @default(0)
  createdById        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  routines           RoutineTask[]
}

// Routine task: a reusable task definition with SLA rules (Task Settings). Picking one in
// Create Task prefills the task and snapshots the SLA thresholds onto it, so editing the
// routine later never changes the SLA of tasks already in flight.
// SLA on elapsed working time: < critical → Normal · ≥ critical → Critical · ≥ delayed → Delayed.
// normalMinutes is the target ("Normal Time") and becomes the task's estimatedMinutes.
model RoutineTask {
  id              String        @id @default(uuid())
  title           String
  description     String?
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  priority        String        @default("Medium") // Urgent | High | Medium | Low
  normalMinutes   Int
  criticalMinutes Int
  delayedMinutes  Int
  templateId      String? // optional blueprint: work type + checklist
  template        TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isActive        Boolean       @default(true)
  createdById     String?
  createdBy       User?         @relation("routineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks           Task[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([departmentId, title])
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String
  passwordHash String
  role         String // ADMIN | SALES | DESIGNER | IT
  title        String? // e.g. "Sales Agent"
  color        String  @default("#2564CF")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignedTasks Task[]              @relation("assignee")
  createdTasks  Task[]              @relation("creator")
  reviewTasks   Task[]              @relation("reviewer")
  activities    Activity[]
  comments      Comment[]
  history       AssignmentHistory[] @relation("historyAssignee")
  notifications Notification[]
  voiceNotes    TaskVoiceNote[]     @relation("voiceNoteRecorder")
  routinesCreated RoutineTask[]     @relation("routineCreator")
  createdAt     DateTime            @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  type      String   @default("Reminder") // Reminder | System
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Task {
  id       String  @id @default(uuid())
  taskNo   String  @unique // TASK-2026-00125
  title    String
  subtitle String?
  description String?

  entityType String // Artwork | Sales Order | Lead | System
  entityId   String // AW-2026-000125
  taskType   String // Background Removal | Bug Fix | ...
  actionType String @default("H") // A = Automatic/AI · H = Human task · G = Validation Gate (manager approval)
  priority   String @default("Medium") // Urgent | High | Medium | Low
  status     String @default("Pending") // see state machine

  parentTaskId String?
  parentTask   Task?   @relation("subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]  @relation("subtasks")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignedUserId String?
  assignedUser   User?   @relation("assignee", fields: [assignedUserId], references: [id])
  createdById    String
  createdBy      User    @relation("creator", fields: [createdById], references: [id])
  reviewerId     String?
  reviewer       User?   @relation("reviewer", fields: [reviewerId], references: [id])

  requiresAcceptance Boolean @default(false)
  requiresReview     Boolean @default(true)

  // Routine-task provenance + SLA thresholds snapshotted at creation (estimatedMinutes = normal/target)
  routineTaskId      String?
  routineTask        RoutineTask? @relation(fields: [routineTaskId], references: [id], onDelete: SetNull)
  slaCriticalMinutes Int?
  slaDelayedMinutes  Int?

  startAfter        DateTime?
  dueAt             DateTime?
  estimatedMinutes  Int?
  startedAt         DateTime?
  submittedAt       DateTime?
  completedAt       DateTime?
  completionSummary String?
  performedByType   String    @default("User") // User | AI
  affectedSystem    String? // IT tickets
  metadata          String? // JSON string (Json type unsupported on SQLite)
  voiceNote         String? // base64 data URL of a recorded voice instruction
  voiceTranscript   String? // speech-to-text transcript of the voice note

  checklist  ChecklistItem[]
  comments   Comment[]
  activity   Activity[]
  history    AssignmentHistory[]
  aiRuns        AiRun[]
  voiceNotes    TaskVoiceNote[]
  notifications Notification[]
  dependencies TaskDependency[] @relation("dependent")    // tasks this one WAITS ON
  dependents   TaskDependency[] @relation("prerequisite") // tasks WAITING ON this one
  files        TaskFile[]
  artworks     TaskArtwork[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model TaskVoiceNote {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  sequenceNo Int
  audioData  String // base64 data URL
  transcript String? // speech-to-text transcript
  fileName        String? // e.g. print_alignment_check.mp3 (uploads) or "Recording 3"
  durationSeconds Int?
  recordedById    String?
  recordedBy      User?    @relation("voiceNoteRecorder", fields: [recordedById], references: [id])
  createdAt  DateTime @default(now())
}

model AssignmentHistory {
  id             String    @id @default(uuid())
  taskId         String
  task           Task      @relation(fields: [taskId], references: [id])
  previousUserId String?
  assignedUserId String?
  assignedUser   User?     @relation("historyAssignee", fields: [assignedUserId], references: [id])
  assignedById   String?
  reason         String?
  assignedAt     DateTime  @default(now())
  acceptedAt     DateTime?
  releasedAt     DateTime?
}

model ChecklistItem {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id])
  sequenceNo    Int
  item          String
  isRequired    Boolean   @default(true)
  isCompleted   Boolean   @default(false)
  completedById String?
  completedAt   DateTime?
  notes         String?
}

model Comment {
  id              String    @id @default(uuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id])
  commentType     String    @default("Comment") // Comment | Question | Answer | Feedback
  commentText     String
  audioData       String? // base64 data URL of a recorded voice note
  audioTranscript String? // speech-to-text transcript of the voice note
  parentCommentId String?
  commentedById   String
  commentedBy     User      @relation(fields: [commentedById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model Activity {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id])
  activityType  String // Created | Assigned | Started | Paused | Submitted | Approved | Rejected | Reopened | Cancelled | Commented
  oldStatus     String?
  newStatus     String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  notes         String?
  metadata      String?
  createdAt     DateTime @default(now())
}

model AiRun {
  id              String    @id @default(uuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id])
  agentType       String
  modelName       String?
  runStatus       String    @default("Queued") // Queued | Running | Completed | Failed
  confidenceScore Float?
  qualityScore    Float?
  similarityScore Float?
  inputImageUrl   String? // what the agent analyzed
  metadata        String? // JSON: detailed findings (width, height, dpi, hasAlpha, issues…)
  resultSummary   String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
}

// A file attached to a task — customer image, reference, or a produced result. Stored as a
// base64 data URL (same as voice notes); the API caps size and streams it back on read.
model TaskFile {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  fileName     String
  fileType     String?
  kind         String   @default("attachment") // attachment | result | reference
  dataUrl      String // base64 data URL
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime @default(now())
}

// An artwork picked from the central Artwork Vault and sent to this task — from Design Studio's
// vault grid, or from any app that can name a vault asset. The bytes stay in Nextcloud: only the
// asset id (so the studio can re-open the original) and a small thumbnail (so any app can show it
// without vault access) are kept here. fileName is the vault's own name, never a renamed copy.
model TaskArtwork {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  assetId      String   // artwork_vault_assets.id in the central DB
  fileName     String   // exact source name, e.g. AW-WALB-0142-FNL.png
  artworkCode  String?
  customerName String?
  folder       String?
  mimeType     String?
  sizeBytes    Int?
  thumbData    String?  // small data URL preview (<= ~200 KB), rendered where the vault is unreachable
  sourceApp    String   @default("design-studio")
  addedById    String?
  createdAt    DateTime @default(now())

  @@unique([taskId, assetId])
}

// A task (taskId) waits on a predecessor (dependsOnTaskId). The dependent stays in "Waiting"
// until every predecessor is Completed, then it is activated (Waiting -> Assigned/Pending).
model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation("dependent", fields: [taskId], references: [id])
  dependsOnTaskId String
  dependsOnTask   Task     @relation("prerequisite", fields: [dependsOnTaskId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
}
